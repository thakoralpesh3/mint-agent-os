[Unit]
Description=MintPilot Autonomous Offline Laptop Controller Agent
After=network.target graphical.target

[Service]
Type=simple
User=mint
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/mint/.Xauthority
WorkingDirectory=/opt/mint-agent
ExecStart=/usr/bin/python3 /opt/mint-agent/agent/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
