{
  "mode": "turbo",
  "webui": {
    "host": "0.0.0.0",
    "port": 8888,
    "enabled": true
  },
  "hardware": {
    "target_ram_mb": 4096,
    "memory_guard_threshold_percent": 85,
    "auto_clean_cache": true
  },
  "browser": {
    "default_browser": "firefox",
    "prefer_cdp": true,
    "enable_gui_fallback": true
  },
  "hotkeys": {
    "hud_summon": "<Super>space",
    "turbo_toggle": "<Super><Alt>t"
  },
  "interaction": {
    "modality": "hybrid",
    "verbosity": "concise",
    "proactivity": "balanced",
    "voice": {
      "enabled": true,
      "engine": "spd-say",
      "speed": 165,
      "pitch": 0,
      "volume": 100,
      "auto_listen_wake_word": false
    },
    "notifications": {
      "enabled": true,
      "urgency_threshold": "normal",
      "sound": false
    },
    "hud": {
      "hotkey": "<Super>space",
      "keep_centered": true,
      "auto_hide_sec": 3
    }
  },
  "marvel_persona": "karen"
}